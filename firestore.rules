rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.id is string && data.id == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidFavorite(data, placeId) {
      return data.placeId is string && data.placeId == placeId && data.placeId.size() <= 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.category is string && data.category.size() <= 50 &&
             data.region is string && data.region.size() <= 50 &&
             (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
             (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5)) &&
             (!('priceTag' in data) || (data.priceTag is string && data.priceTag.size() <= 100)) &&
             (!('contactNumber' in data) || (data.contactNumber is string && data.contactNumber.size() <= 50)) &&
             data.savedAt is timestamp && data.savedAt <= request.time;
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) &&
                       incoming().keys().hasAll(['id', 'email', 'createdAt']) &&
                       isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);

      match /favorites/{placeId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(placeId) &&
                                 incoming().keys().hasAll(['placeId', 'name', 'category', 'region', 'savedAt']) &&
                                 isValidFavorite(incoming(), placeId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(placeId);
      }
    }
  }
}
